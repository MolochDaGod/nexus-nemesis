# Nexus Nemesis — Production Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# Crossmint (Solana cNFT minting)
CROSSMINT_API_KEY=sk_production_YOUR_KEY_HERE
CROSSMINT_CLIENT_KEY=ck_production_YOUR_KEY_HERE
CROSSMINT_PROJECT_ID=your_project_id
CROSSMINT_COLLECTION_ID=your_collection_id_here
CROSSMINT_WEBHOOK_SECRET=whsec_YOUR_ROTATED_SECRET_HERE

# Admin wallet (Solana public address only)
ADMIN_WALLET_ADDRESS=your_solana_wallet_here

# Grudge Backend DB
DATABASE_URL=postgresql://user:pass@db.grudge-studio.com:5432/grudge_nexus

# Discord webhooks (card events)
DISCORD_WEBHOOK_CARDS=https://discord.com/api/webhooks/YOUR_WEBHOOK
DISCORD_WEBHOOK_CARDOPEN=https://discord.com/api/webhooks/YOUR_WEBHOOK

# GBUX token (Solana SPL token)
GBUX_MINT_ADDRESS=your_gbux_token_mint_here

# Grudge Auth (shared JWT secret from Auth Gateway)
GRUDGE_JWT_SECRET=your_jwt_secret_from_auth_gateway
GRUDGE_AUTH_URL=https://auth-gateway-otb8qmmyd-grudgenexus.vercel.app

# Server
PORT=3100
NODE_ENV=production
