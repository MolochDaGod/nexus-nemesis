{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "production": true,
      "preview": false
    }
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/favicon.ico", "destination": "/api" },
    { "source": "/", "destination": "/api" }
  ],
  "env": {
    "VERCEL": "1"
  }
}
